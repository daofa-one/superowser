{
  "name": "Superowser",
  "version": "0.0.1.0",
  "version_name": "0.0.1",
  "manifest_version": 3,
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Superowser"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "assets/index.ts-D04QXyad.js"
      ],
      "all_frames": false,
      "matches": [
        "*://*/*",
        "<all_urls>"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "*://*/*",
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "activeTab",
    "background",
    "contextMenus",
    "favicon",
    "sidePanel",
    "scripting"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://*/*",
        "<all_urls>"
      ],
      "resources": [
        "assets/index.ts-D04QXyad.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
